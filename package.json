{
  "name": "luke-shop-platform-admin",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4172",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4172",
    "deploy": "npm run verify && npm run build && wrangler deploy",
    "deploy:production": "npm run deploy",
    "cf:types": "wrangler types",
    "check": "node scripts/check-source.mjs",
    "test:source": "node scripts/source-regression-test.mjs",
    "verify": "npm run check && npm run test:source && npm run test:design && npm run test:studio-v3 && npm run test:control-v04 && npm run test:status-visual-v05 && npm run test:identity-v06 && npm run test:tenant-experience-v07 && npm run test:themes-v08",
    "test:design": "node scripts/design-regression-test.mjs",
    "test:studio-v3": "node scripts/v0.3.1-template-studio-regression-test.mjs",
    "test:control-v04": "node scripts/v0.4.0-platform-control-completion-regression-test.mjs",
    "test:status-visual-v05": "node scripts/v0.5.0-status-visual-control-regression-test.mjs",
    "test:identity-v06": "node scripts/v0.6.0-customer-identity-governance-regression-test.mjs",
    "test:tenant-experience-v07": "node scripts/v0.7.0-tenant-experience-capability-regression-test.mjs",
    "test:themes-v08": "node scripts/v0.8.0-theme-library-v1-a1-regression-test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "vite": "7.3.6",
    "wrangler": "4.126.0"
  },
  "description": "Luke Shop Platform Admin v0.8.0 — Theme Library & Design System Distribution"
}
